{
  "version": 1,
  "group": "mod",
  "properties": [
    {
      "name": "BUILD_COORDS",
      "type": "build_system_coordinates",
      "order": 10
    },
    {
      "name": "VERSIONS",
      "type": "forge_versions",
      "parameters": {
        "mcVersionFilter": "$MC_VERSION.compareTo($mcver.MC1_18_2) == 0"
      }
    },
    {
      "name": "MOD_ID",
      "type": "string",
      "validator": "[a-z][a-z0-9-_]{1,63}",
      "derives": {
        "parents": ["PROJECT_NAME"],
        "method": "replace",
        "parameters": {
          "regex": "[^a-z0-9-_]+",
          "replacement": "_",
          "maxLength": 64,
          "lowercase": true
        }
      }
    },
    {
      "name": "MOD_NAME",
      "type": "string",
      "inheritFrom": "PROJECT_NAME"
    },
    {
      "name": "MAIN_CLASS",
      "type": "class_fqn",
      "derives": {
        "parents": ["BUILD_COORDS", "MOD_ID"],
        "method": "suggestClassName"
      }
    },
    {
      "name": "LICENSE",
      "type": "license"
    },
    {
      "label": "creator.ui.optional_settings.label",
      "collapsible": true,
      "default": true,
      "groupProperties": [
        {
          "name": "DESCRIPTION",
          "type": "string",
          "default": ""
        },
        {
          "name": "AUTHORS",
          "type": "inline_string_list",
          "default": ""
        }
      ]
    },
    {
      "name": "JAVA_VERSION",
      "type": "integer",
      "order": 20,
      "default": 17,
      "visible": false
    },
    {
      "name": "JDK",
      "type": "jdk",
      "order": 20,
      "default": "JAVA_VERSION"
    }
  ],
  "files": [
    {
      "template": "../Gradle.gitignore.ft",
      "destination": ".gitignore",
      "condition": "$USE_GIT"
    },
    {
      "template": "../gradle-wrapper.properties.ft",
      "destination": "gradle/wrapper/gradle-wrapper.properties"
    },
    {
      "template": "../licenses/${LICENSE.id}.txt.ft",
      "destination": "LICENSE.txt"
    },
    {
      "template": "build.gradle.ft",
      "destination": "build.gradle"
    },
    {
      "template": "settings.gradle.ft",
      "destination": "settings.gradle"
    },
    {
      "template": "gradle.properties.ft",
      "destination": "gradle.properties"
    },
    {
      "template": "mixins.json.ft",
      "destination": "src/main/resources/${MOD_ID}.mixins.json"
    },
    {
      "template": "pack.mcmeta.ft",
      "destination": "src/main/resources/pack.mcmeta"
    },
    {
      "template": "en_us.json.ft",
      "destination": "src/main/resources/assets/${MOD_ID}/lang/en_us.json"
    },
    {
      "template": "ExampleMod.java.ft",
      "destination": "src/main/java/${MAIN_CLASS.path}.java"
    },
    {
      "template": "mods.toml.ft",
      "destination": "src/main/resources/META-INF/mods.toml"
    }
  ],
  "finalizers": [
    {
      "type": "import_gradle_project"
    },
    {
      "type": "run_gradle_tasks",
      "tasks": ["wrapper", "genIntellijRuns"]
    },
    {
      "type": "git_add_all",
      "condition": "$USE_GIT"
    }
  ]
}
